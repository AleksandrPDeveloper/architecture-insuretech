        <mxCell id="5CTINeBt0gx7lqWLaeEx-116" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;РЕПЛИКАЦИЯ&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="5CTINeBt0gx7lqWLaeEx-113">
